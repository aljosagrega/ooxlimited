# Copy to .env.local (dev) or set in the service environment (prod).
SESSION_SECRET=            # >=32 chars — `openssl rand -hex 32`. Signs the admin cookie.
ADMIN_USERNAME=            # bootstraps the admin login on first use
ADMIN_PASSWORD=            # bootstraps the admin login on first use
SITE_URL=https://ooxlimited.com

RESEND_API_KEY=            # resend.com — contact form email. Blank = store only.
RESEND_FROM_EMAIL=OOX Limited <hello@ooxlimited.com>   # domain must be verified in Resend

MAILCHIMP_API_KEY=         # xxxxxxxx-usXX — newsletter audience. Blank = store only.
MAILCHIMP_LIST_ID=         # audience/list id
