# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
/dist/
tsconfig.tsbuildinfo
next-env.d.ts

# Environment
.env
.env*.local
.env.production

# OS / editor
.DS_Store
.vscode/
.idea/

# Admin login credentials (hashed) — bootstrapped from env on first use
src/data/adminAuth.json

# Captured form submissions — runtime PII (emails)
src/data/submissions.json

# Admin-uploaded media (runtime state)
public/media/uploads/

# The app ships self-contained: the frozen page markup (src/data/frozen/), the
# rewritten CSS (public/_css/) and the exact set of theme/plugin asset files the
# pages load (public/wp-content, public/wp-includes — produced by
# `npm run collect-assets`) are ALL committed. Regenerate with
# `npm run freeze && npm run build:maps && npm run collect-assets` when the
# WordPress copy changes.
#
# The ONLY thing kept out is the media library — it's client host state, large,
# and rsynced by the server at deploy (see DEPLOYMENT.md). Locally it's a symlink.
/public/wp-content/uploads

# Local working files — screenshots, ad-hoc probe scripts. Regenerate, don't commit.
scratchpad/

# Debug logs
npm-debug.log*

# CI release staging dir (assembled by .github/workflows/deploy.yml)
deploy/
