    {
      "id": "e19",
      "kind": "text",
      "label": "P: “Our game development team is made up of designers, develope…”",
      "group": "Page",
      "value": "Our game development team is made up of designers, developers, artists, and producers who specialize in different parts of the development process."
    },
    {
      "id": "e20",
      "kind": "text",
      "label": "P: “Our mobile game developers focus on building stable and sca…”",
      "group": "Page",
      "value": "Our mobile game developers focus on building stable and scalable systems, while our game design team defines gameplay, mechanics, and player experience. Artists and art directors ensure visual consistency, and producers keep everything aligned with timelines and business goals."
    },
    {
      "id": "e21",
      "kind": "text",
      "label": "P: “We work as a single unit, not separate roles. This allows u…”",
      "group": "Page",
      "value": "We work as a single unit, not separate roles. This allows us to move faster, adapt quickly, and deliver products that are both functional and engaging."
    },
