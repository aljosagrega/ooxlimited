.team-qa-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 18px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
}

.team-qa-question {
    font-size: 18px;
    font-weight: 700;
    color: var(--e-global-color-primary, #1a1a1a);
    flex: 1;
}

.team-qa-icon {
    position: relative;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.team-qa-icon::before,
.team-qa-icon::after {
    content: "";
    position: absolute;
    background: var(--e-global-color-primary, #1a1a1a);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
}

.team-qa-icon::before {
    width: 22px;
    height: 3px;
}

.team-qa-icon::after {
    width: 3px;
    height: 22px;
}

.team-qa-item.active .team-qa-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
}

.team-qa-answer {
    display: none;
    padding: 0 0 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--e-global-color-text, #555);
}

